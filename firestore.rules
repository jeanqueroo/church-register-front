rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserRoles() {
      return userDocExists() ? currentUserData().get('roles', []) : [];
    }

    function userHasRole(role) {
      return isSignedIn() && currentUserRoles().hasAny([role]);
    }

    // Super administrador: iglesias y registro de administradores de iglesia.
    function isSuperAdmin() {
      return isSignedIn() && (
        !userDocExists() ||
        currentUserRoles().size() == 0 ||
        userHasRole('superadmin')
      );
    }

    // Administrador de una sede (rol `admin` en Firestore).
    function isChurchAdmin() {
      return isSignedIn() && userHasRole('admin');
    }

    function isAppAdmin() {
      return isSuperAdmin() || isChurchAdmin();
    }

    function isStaffUser() {
      return isSignedIn() && (
        isSuperAdmin() ||
        isChurchAdmin() ||
        currentUserRoles().hasAny(['supervisor'])
      );
    }

    function isRegistrar() {
      return userHasRole('registrador');
    }

    // Admin, superadmin o registrador: creyentes, líderes y avisos al asignar.
    function canManageChurchRecords() {
      return isAppAdmin() || isRegistrar();
    }

    function isAssignedLeaderForNotification() {
      return userDocExists() &&
        currentUserData().get('leaderId', '') != '' &&
        currentUserData().get('leaderId', '') == resource.data.get('leaderId', '');
    }

    function canManageOtherUsers() {
      return isSuperAdmin();
    }

    function currentUserChurchId() {
      return userDocExists() ? currentUserData().get('churchId', '') : '';
    }

    // Admin de iglesia: asignar líderes a supervisores de su sede.
    function canChurchAdminAssignSupervisorLeaders() {
      return isChurchAdmin() &&
        resource.data.get('roles', []).hasAny(['supervisor']) &&
        resource.data.get('churchId', '') != '' &&
        resource.data.get('churchId', '') == currentUserChurchId() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['supervisedLeaderIds', 'updatedAt']);
    }

    // Admin de iglesia: actualizar roles de líderes de su sede al editarlos.
    function canChurchAdminUpdateLeaderRoles() {
      return isChurchAdmin() &&
        currentUserChurchId() != '' &&
        resource.data.get('churchId', '') == currentUserChurchId() &&
        !resource.data.get('roles', []).hasAny(['superadmin', 'admin']) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['roles', 'updatedAt']);
    }

    match /members/{memberId} {
      allow read, write: if isSignedIn();
    }

    match /leaders/{leaderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Avisos al asignar creyentes (colección raíz usada por la app).
    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (
        canManageChurchRecords() ||
        resource.data.get('recipientUserId', '') == request.auth.uid ||
        isAssignedLeaderForNotification()
      );
    }

    function canEditOwnChurch(churchId) {
      return currentUserChurchId() != '' &&
        currentUserChurchId() == churchId &&
        isChurchAdmin();
    }

    match /churches/{churchId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || canEditOwnChurch(churchId);
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId || isStaffUser()
      );
      // Necesario para `users.where('roles', arrayContains: 'supervisor')`.
      allow list: if isStaffUser();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        canManageOtherUsers() ||
        canChurchAdminAssignSupervisorLeaders() ||
        canChurchAdminUpdateLeaderRoles()
      );

      // Buzón del líder: solo él lee; cualquier usuario autenticado puede crear (registro).
      match /notifications/{notificationId} {
        allow read, update: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn();
      }
    }
  }
}
