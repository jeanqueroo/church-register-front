rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserRoles() {
      return userDocExists() ? currentUserData().get('roles', []) : [];
    }

    function userHasRole(role) {
      return isSignedIn() && currentUserRoles().hasAny([role]);
    }

    // La app trata como admin si no hay documento o roles vacíos (cuenta de Firebase Console).
    function isAppAdmin() {
      return isSignedIn() && (
        !userDocExists() ||
        currentUserRoles().size() == 0 ||
        userHasRole('admin')
      );
    }

  // Admin o supervisor en Firestore: lectura de perfiles y consultas en `users`.
    function isStaffUser() {
      return isSignedIn() && (
        !userDocExists() ||
        currentUserRoles().size() == 0 ||
        currentUserRoles().hasAny(['admin', 'supervisor'])
      );
    }

    function isAdminOrSupervisor() {
      return isStaffUser();
    }

    function canManageSupervisorAssignments() {
      return isAppAdmin();
    }

    match /members/{memberId} {
      allow read, write: if isSignedIn();
    }

    match /leaders/{leaderId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAppAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId || isStaffUser()
      );
      // Necesario para `users.where('roles', arrayContains: 'supervisor')`.
      allow list: if isStaffUser();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == userId || canManageSupervisorAssignments()
      );

      // Buzón del líder: solo él lee; cualquier usuario autenticado puede crear (registro).
      match /notifications/{notificationId} {
        allow read, update: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn();
      }
    }
  }
}
