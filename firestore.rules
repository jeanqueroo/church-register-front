rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserRoles() {
      return userDocExists() ? currentUserData().get('roles', []) : [];
    }

    function userHasRole(role) {
      return isSignedIn() && currentUserRoles().hasAny([role]);
    }

    // Super administrador: iglesias y registro de administradores de iglesia.
    function isSuperAdmin() {
      return isSignedIn() && (
        !userDocExists() ||
        currentUserRoles().size() == 0 ||
        userHasRole('superadmin')
      );
    }

    // Administrador de una sede (rol `admin` en Firestore).
    function isChurchAdmin() {
      return isSignedIn() && userHasRole('admin');
    }

    function isAppAdmin() {
      return isSuperAdmin() || isChurchAdmin();
    }

    function isStaffUser() {
      return isSignedIn() && (
        isSuperAdmin() ||
        isChurchAdmin() ||
        currentUserRoles().hasAny(['supervisor'])
      );
    }

    function isRegistrar() {
      return userHasRole('registrador');
    }

    function isLeader() {
      return userHasRole('leader');
    }

    function isSupervisor() {
      return userHasRole('supervisor');
    }

    function currentUserLeaderId() {
      return userDocExists() ? currentUserData().get('leaderId', '') : '';
    }

    // Admin, superadmin o registrador: creyentes, líderes y avisos al asignar.
    function canManageChurchRecords() {
      return isAppAdmin() || isRegistrar();
    }

    function isAssignedLeaderForMember() {
      return isLeader() &&
        currentUserLeaderId() != '' &&
        resource.data.get('assignedLeaderId', '') == currentUserLeaderId();
    }

    function isSupervisedLeaderMember() {
      return isSupervisor() &&
        resource.data.get('assignedLeaderId', '') != '' &&
        currentUserData().get('supervisedLeaderIds', [])
          .hasAny([resource.data.get('assignedLeaderId', '')]);
    }

    function memberData(memberId) {
      return get(/databases/$(database)/documents/members/$(memberId)).data;
    }

    function isAssignedLeaderForMemberId(memberId) {
      return isLeader() &&
        currentUserLeaderId() != '' &&
        memberData(memberId).get('assignedLeaderId', '') == currentUserLeaderId();
    }

    function isSupervisedLeaderForMemberId(memberId) {
      return isSupervisor() &&
        memberData(memberId).get('assignedLeaderId', '') != '' &&
        currentUserData().get('supervisedLeaderIds', [])
          .hasAny([memberData(memberId).get('assignedLeaderId', '')]);
    }

    function canReadVisitDocument() {
      return isSuperAdmin() ||
        (
          (isChurchAdmin() || isRegistrar()) &&
          currentUserChurchId() != '' &&
          resource.data.get('churchId', '') == currentUserChurchId()
        ) ||
        (isSupervisor() &&
          resource.data.get('leaderId', '') != '' &&
          currentUserData().get('supervisedLeaderIds', [])
            .hasAny([resource.data.get('leaderId', '')])) ||
        (isLeader() &&
          currentUserLeaderId() != '' &&
          resource.data.get('leaderId', '') == currentUserLeaderId());
    }

    function isAssignedLeaderForNotification() {
      return userDocExists() &&
        currentUserData().get('leaderId', '') != '' &&
        currentUserData().get('leaderId', '') == resource.data.get('leaderId', '');
    }

    function canManageOtherUsers() {
      return isSuperAdmin();
    }

    function currentUserChurchId() {
      return userDocExists() ? currentUserData().get('churchId', '') : '';
    }

    // Admin de iglesia: asignar líderes a supervisores de su sede.
    function canChurchAdminAssignSupervisorLeaders() {
      return isChurchAdmin() &&
        resource.data.get('roles', []).hasAny(['supervisor']) &&
        resource.data.get('churchId', '') != '' &&
        resource.data.get('churchId', '') == currentUserChurchId() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['supervisedLeaderIds', 'updatedAt']);
    }

    // Admin de iglesia: actualizar roles de líderes de su sede al editarlos.
    function canChurchAdminUpdateLeaderRoles() {
      return isChurchAdmin() &&
        currentUserChurchId() != '' &&
        resource.data.get('churchId', '') == currentUserChurchId() &&
        !resource.data.get('roles', []).hasAny(['superadmin', 'admin']) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['roles', 'updatedAt']);
    }

    match /members/{memberId} {
      allow read: if isSignedIn() && (
        canManageChurchRecords() ||
        isAssignedLeaderForMember() ||
        isSupervisedLeaderMember()
      );
      allow create, update, delete: if isSignedIn() && canManageChurchRecords();

      match /visits/{visitId} {
        allow read: if isSignedIn() && (
          canReadVisitDocument() ||
          isAssignedLeaderForMemberId(memberId) ||
          isSupervisedLeaderForMemberId(memberId)
        );
        allow create: if isSignedIn() &&
          isAssignedLeaderForMemberId(memberId) &&
          request.resource.data.leaderId == currentUserLeaderId() &&
          request.resource.data.memberId == memberId &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() > 0 &&
          request.resource.data.comment.size() <= 2000 &&
          request.resource.data.visitPlace is string &&
          request.resource.data.visitPlace in [
            'casa', 'hospital', 'trabajo', 'iglesia', 'videollamada'
          ] &&
          request.resource.data.prayerPerformed is bool &&
          request.resource.data.needsFollowUp is bool &&
          (
            !('approximateDuration' in request.resource.data) ||
            (
              request.resource.data.approximateDuration is string &&
              request.resource.data.approximateDuration.size() <= 100
            )
          ) &&
          (
            !('prayerRequests' in request.resource.data) ||
            (
              request.resource.data.prayerRequests is string &&
              request.resource.data.prayerRequests.size() <= 2000
            )
          ) &&
          (
            !('spiritualState' in request.resource.data) ||
            request.resource.data.spiritualState in [
              'nuevoCreyente', 'enDiscipulado', 'miembroActivo',
              'alejado', 'visitanteFrecuente'
            ]
          );
        allow update, delete: if isSignedIn() && canManageChurchRecords();
      }
    }

    match /leaders/{leaderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Avisos al asignar creyentes (colección raíz usada por la app).
    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (
        canManageChurchRecords() ||
        resource.data.get('recipientUserId', '') == request.auth.uid ||
        isAssignedLeaderForNotification()
      );
    }

    function canEditOwnChurch(churchId) {
      return currentUserChurchId() != '' &&
        currentUserChurchId() == churchId &&
        isChurchAdmin();
    }

    match /churches/{churchId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || canEditOwnChurch(churchId);
      allow delete: if false;
    }

    // Consultas collection group para el dashboard de visitas.
    match /{path=**}/visits/{visitId} {
      allow read: if isSignedIn() && canReadVisitDocument();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId || isStaffUser()
      );
      // Necesario para `users.where('roles', arrayContains: 'supervisor')`.
      allow list: if isStaffUser();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        canManageOtherUsers() ||
        canChurchAdminAssignSupervisorLeaders() ||
        canChurchAdminUpdateLeaderRoles()
      );

      // Buzón del líder: solo él lee; cualquier usuario autenticado puede crear (registro).
      match /notifications/{notificationId} {
        allow read, update: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn();
      }
    }
  }
}
