{
  "hosting": {
    "public": "hosting/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "church-register-pro",
          "appId": "1:401692251430:android:50d2c2b6d227cb6ee31de7",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "church-register-pro",
          "configurations": {
            "android": "1:401692251430:android:50d2c2b6d227cb6ee31de7",
            "ios": "1:401692251430:ios:3fbfc9dd0144b8fbe31de7",
            "web": "1:401692251430:web:e844e745bfe73e6de31de7"
          }
        }
      }
    }
  }
}
